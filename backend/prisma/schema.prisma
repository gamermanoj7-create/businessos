generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum MembershipStatus { ACTIVE SUSPENDED REMOVED }
enum SystemRole { OWNER ADMIN MANAGER STAFF ACCOUNTANT }
enum StockMovementType { PURCHASE_IN SALE_OUT SALE_RETURN_IN PURCHASE_RETURN_OUT ADJUSTMENT_IN ADJUSTMENT_OUT DAMAGE_OUT OPENING }
enum SaleStatus { DRAFT CONFIRMED CANCELLED RETURNED PARTIALLY_RETURNED }
enum InvoiceStatus { DRAFT ISSUED PAID PARTIALLY_PAID OVERDUE CANCELLED VOID }
enum PaymentMethod { CASH UPI CARD BANK_TRANSFER CREDIT OTHER }
enum PaymentDirection { INCOMING OUTGOING }
enum ExpenseCategory { RENT SALARY_UTILITIES_MARKETING_TRANSPORT_PURCHASE_TAX_BANK_FEE_OTHER }
enum SyncOperation { CREATE UPDATE DELETE }
enum SyncStatus { PENDING APPLIED CONFLICT FAILED }

model User {
  id String @id @default(uuid())
  name String
  email String @unique
  phone String?
  passwordHash String
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships BusinessMember[]
  sessions Session[]
  auditLogs AuditLog[] @relation("AuditLogActor")
  syncChanges SyncChange[]
  aiConversations AiConversation[]
  syncDevices SyncDevice[]
  @@index([email])
  @@map("users")
}
model Session {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  refreshTokenHash String @unique
  userAgent String?
  ipAddress String?
  isRevoked Boolean @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
model Business {
  id String @id @default(uuid())
  name String
  legalName String?
  phone String?
  email String?
  address String?
  city String?
  state String?
  country String? @default("IN")
  pincode String?
  gstNumber String?
  currency String @default("INR")
  timezone String @default("Asia/Kolkata")
  invoicePrefix String @default("INV")
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members BusinessMember[]
  roles Role[]
  categories Category[]
  products Product[]
  customers Customer[]
  suppliers Supplier[]
  inventory Inventory[]
  stockMoves StockMovement[]
  purchases Purchase[]
  sales Sale[]
  invoices Invoice[]
  payments Payment[]
  expenses Expense[]
  cashEntries CashEntry[]
  auditLogs AuditLog[]
  syncChanges SyncChange[]
  syncDevices SyncDevice[]
  aiConversations AiConversation[]
  @@index([name])
  @@map("businesses")
}
model BusinessMember {
  id String @id @default(uuid())
  userId String
  businessId String
  roleId String
  status MembershipStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  role Role @relation(fields:[roleId], references:[id], onDelete:Restrict)
  @@unique([userId,businessId])
  @@index([businessId])
  @@map("business_members")
}
model Role {
  id String @id @default(uuid())
  businessId String
  name String
  systemRole SystemRole?
  isSystem Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  members BusinessMember[]
  rolePermissions RolePermission[]
  @@unique([businessId,name])
  @@index([businessId])
  @@map("roles")
}
model Permission {
  id String @id @default(uuid())
  key String @unique
  description String?
  createdAt DateTime @default(now())
  rolePermissions RolePermission[]
  @@map("permissions")
}
model RolePermission {
  id String @id @default(uuid())
  roleId String
  permissionId String
  role Role @relation(fields:[roleId], references:[id], onDelete:Cascade)
  permission Permission @relation(fields:[permissionId], references:[id], onDelete:Cascade)
  @@unique([roleId,permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

model Category {
  id String @id @default(uuid())
  businessId String
  name String
  description String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  products Product[]
  @@unique([businessId,name])
  @@index([businessId])
  @@map("categories")
}
model Product {
  id String @id @default(uuid())
  businessId String
  categoryId String?
  name String
  sku String?
  barcode String?
  description String?
  unit String @default("pcs")
  purchasePrice Decimal @db.Decimal(12,2) @default(0)
  sellingPrice Decimal @db.Decimal(12,2) @default(0)
  taxRate Decimal @db.Decimal(5,2) @default(0)
  hsnCode String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  category Category? @relation(fields:[categoryId], references:[id], onDelete:SetNull)
  inventory Inventory?
  stockMoves StockMovement[]
  purchaseItems PurchaseItem[]
  saleItems SaleItem[]
  invoiceItems InvoiceItem[]
  @@unique([businessId,sku])
  @@unique([businessId,barcode])
  @@index([businessId,name])
  @@index([businessId,categoryId])
  @@map("products")
}
model Inventory {
  id String @id @default(uuid())
  businessId String
  productId String @unique
  quantity Decimal @db.Decimal(14,3) @default(0)
  minStock Decimal @db.Decimal(14,3) @default(0)
  updatedAt DateTime @updatedAt
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  @@index([businessId])
  @@map("inventory")
}
model StockMovement {
  id String @id @default(uuid())
  businessId String
  productId String
  type StockMovementType
  quantity Decimal @db.Decimal(14,3)
  reference String?
  notes String?
  createdAt DateTime @default(now())
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  @@index([businessId,productId,createdAt])
  @@map("stock_movements")
}

model Customer {
  id String @id @default(uuid())
  businessId String
  name String
  phone String?
  email String?
  address String?
  gstNumber String?
  openingBalance Decimal @db.Decimal(14,2) @default(0)
  creditLimit Decimal @db.Decimal(14,2) @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  sales Sale[]
  invoices Invoice[]
  payments Payment[]
  @@index([businessId,name])
  @@index([businessId,phone])
  @@map("customers")
}
model Supplier {
  id String @id @default(uuid())
  businessId String
  name String
  phone String?
  email String?
  address String?
  gstNumber String?
  openingBalance Decimal @db.Decimal(14,2) @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  purchases Purchase[]
  payments Payment[]
  @@index([businessId,name])
  @@map("suppliers")
}

model Purchase {
  id String @id @default(uuid())
  businessId String
  supplierId String?
  purchaseNumber String
  subtotal Decimal @db.Decimal(14,2) @default(0)
  taxTotal Decimal @db.Decimal(14,2) @default(0)
  grandTotal Decimal @db.Decimal(14,2) @default(0)
  status String @default("CONFIRMED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  supplier Supplier? @relation(fields:[supplierId], references:[id], onDelete:SetNull)
  items PurchaseItem[]
  @@unique([businessId,purchaseNumber])
  @@index([businessId,createdAt])
  @@map("purchases")
}
model PurchaseItem {
  id String @id @default(uuid())
  purchaseId String
  productId String
  quantity Decimal @db.Decimal(14,3)
  unitCost Decimal @db.Decimal(12,2)
  taxRate Decimal @db.Decimal(5,2) @default(0)
  lineTotal Decimal @db.Decimal(14,2)
  purchase Purchase @relation(fields:[purchaseId], references:[id], onDelete:Cascade)
  product Product @relation(fields:[productId], references:[id], onDelete:Restrict)
  @@index([purchaseId])
  @@map("purchase_items")
}
model Sale {
  id String @id @default(uuid())
  businessId String
  customerId String?
  status SaleStatus @default(DRAFT)
  subtotal Decimal @db.Decimal(14,2) @default(0)
  discount Decimal @db.Decimal(14,2) @default(0)
  taxTotal Decimal @db.Decimal(14,2) @default(0)
  grandTotal Decimal @db.Decimal(14,2) @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  customer Customer? @relation(fields:[customerId], references:[id], onDelete:SetNull)
  items SaleItem[]
  invoice Invoice?
  @@index([businessId,createdAt])
  @@map("sales")
}
model SaleItem {
  id String @id @default(uuid())
  saleId String
  productId String
  quantity Decimal @db.Decimal(14,3)
  unitPrice Decimal @db.Decimal(12,2)
  discount Decimal @db.Decimal(12,2) @default(0)
  taxRate Decimal @db.Decimal(5,2) @default(0)
  lineTotal Decimal @db.Decimal(14,2)
  sale Sale @relation(fields:[saleId], references:[id], onDelete:Cascade)
  product Product @relation(fields:[productId], references:[id], onDelete:Restrict)
  @@index([saleId])
  @@map("sale_items")
}
model Invoice {
  id String @id @default(uuid())
  businessId String
  saleId String? @unique
  customerId String?
  invoiceNumber String
  status InvoiceStatus @default(DRAFT)
  subtotal Decimal @db.Decimal(14,2) @default(0)
  cgst Decimal @db.Decimal(14,2) @default(0)
  sgst Decimal @db.Decimal(14,2) @default(0)
  igst Decimal @db.Decimal(14,2) @default(0)
  taxTotal Decimal @db.Decimal(14,2) @default(0)
  grandTotal Decimal @db.Decimal(14,2) @default(0)
  amountPaid Decimal @db.Decimal(14,2) @default(0)
  amountDue Decimal @db.Decimal(14,2) @default(0)
  placeOfSupply String?
  issuedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  sale Sale? @relation(fields:[saleId], references:[id], onDelete:SetNull)
  customer Customer? @relation(fields:[customerId], references:[id], onDelete:SetNull)
  items InvoiceItem[]
  payments Payment[]
  @@unique([businessId,invoiceNumber])
  @@index([businessId,status])
  @@map("invoices")
}
model InvoiceItem {
  id String @id @default(uuid())
  invoiceId String
  productId String
  quantity Decimal @db.Decimal(14,3)
  unitPrice Decimal @db.Decimal(12,2)
  taxRate Decimal @db.Decimal(5,2) @default(0)
  lineTotal Decimal @db.Decimal(14,2)
  invoice Invoice @relation(fields:[invoiceId], references:[id], onDelete:Cascade)
  product Product @relation(fields:[productId], references:[id], onDelete:Restrict)
  @@index([invoiceId])
  @@map("invoice_items")
}
model Payment {
  id String @id @default(uuid())
  businessId String
  invoiceId String?
  customerId String?
  supplierId String?
  direction PaymentDirection
  method PaymentMethod
  amount Decimal @db.Decimal(14,2)
  notes String?
  createdAt DateTime @default(now())
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  invoice Invoice? @relation(fields:[invoiceId], references:[id], onDelete:SetNull)
  customer Customer? @relation(fields:[customerId], references:[id], onDelete:SetNull)
  supplier Supplier? @relation(fields:[supplierId], references:[id], onDelete:SetNull)
  @@index([businessId,createdAt])
  @@map("payments")
}
model Expense {
  id String @id @default(uuid())
  businessId String
  category ExpenseCategory
  description String
  amount Decimal @db.Decimal(14,2)
  paymentMethod PaymentMethod @default(CASH)
  expenseDate DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  @@index([businessId,expenseDate])
  @@map("expenses")
}
model CashEntry {
  id String @id @default(uuid())
  businessId String
  direction PaymentDirection
  amount Decimal @db.Decimal(14,2)
  source String
  referenceId String?
  notes String?
  createdAt DateTime @default(now())
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  @@index([businessId,createdAt])
  @@map("cash_entries")
}

model SyncDevice {
  id String @id @default(uuid())
  businessId String
  userId String
  deviceId String
  name String?
  lastSyncAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@unique([businessId,deviceId])
  @@index([userId])
  @@map("sync_devices")
}
model SyncChange {
  id String @id @default(uuid())
  businessId String
  userId String?
  deviceId String?
  entity String
  entityId String
  operation SyncOperation
  version Int @default(1)
  payload Json?
  status SyncStatus @default(PENDING)
  createdAt DateTime @default(now())
  appliedAt DateTime?
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
  @@index([businessId,createdAt])
  @@index([businessId,entity,entityId])
  @@map("sync_changes")
}
model AiConversation {
  id String @id @default(uuid())
  businessId String
  userId String
  title String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  messages AiMessage[]
  @@index([businessId,createdAt])
  @@map("ai_conversations")
}
model AiMessage {
  id String @id @default(uuid())
  conversationId String
  role String
  content String
  createdAt DateTime @default(now())
  conversation AiConversation @relation(fields:[conversationId], references:[id], onDelete:Cascade)
  @@index([conversationId,createdAt])
  @@map("ai_messages")
}
model AuditLog {
  id String @id @default(uuid())
  businessId String?
  userId String?
  action String
  entity String?
  entityId String?
  metadata Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  business Business? @relation(fields:[businessId], references:[id], onDelete:SetNull)
  actor User? @relation("AuditLogActor", fields:[userId], references:[id], onDelete:SetNull)
  @@index([businessId,createdAt])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}
