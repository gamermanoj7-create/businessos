# These are NOT read from a .env file in production — set each one with:
#   wrangler secret put NAME
# This file just documents what's required. Never commit real values.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

WHATSAPP_TOKEN=your-whatsapp-cloud-api-permanent-token
WHATSAPP_PHONE_NUMBER_ID=your-default-whatsapp-phone-number-id
WHATSAPP_VERIFY_TOKEN=choose-any-random-string-for-webhook-verification
WHATSAPP_TEMPLATE_NAME=due_reminder
WHATSAPP_TEMPLATE_LANG=en
